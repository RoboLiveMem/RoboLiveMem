# Copy to .env (never commit it) and fill in the providers you use, then:  set -a; . ./.env; set +a
# Only the keys of the providers you call are needed.

OPENAI_API_KEY=<your-openai-key>
# OPENAI_BASE_URL=http://localhost:8000/v1      # any OpenAI-compatible server (vLLM, Ollama, OpenRouter, ...)

ANTHROPIC_API_KEY=<your-anthropic-key>

GEMINI_API_KEY=<your-gemini-key>

# Amazon Bedrock (API key), as used for most models in the paper
AWS_BEARER_TOKEN_BEDROCK=<your-bedrock-api-key>
AWS_REGION=us-west-2
